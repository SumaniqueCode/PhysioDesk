# Copy to .env. Defaults match the docker-compose Postgres service.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://physiodesk:physiodesk@localhost:5432/physiodesk
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
# Set TRUST_PROXY=true behind a reverse proxy; use a redis:// URI for multi-worker rate limiting.
TRUST_PROXY=false
RATE_LIMIT_STORAGE_URI=memory://
